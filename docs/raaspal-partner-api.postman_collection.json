{
  "info": {
    "name": "RAASPAL Partner API — v1 (OAuth)",
    "description": "Tests the RAASPAL Partner API end to end.\n\nSETUP\n1. Start the backend (mvnw spring-boot:run) or point base_url at production.\n2. Mint a credential: Tools -> Partners -> your partner -> Manage -> Mint key.\n3. Paste the Client ID and Client secret into the collection Variables below.\n4. Run the collection. Request 1 saves {{access_token}}; everything else uses it.\n\nbase_url is set to http://localhost:8080. For production use:\nhttps://ai-robotrecommendationsystem-backend.onrender.com\n\nThe Success folder should pass entirely. The Errors folder asserts that bad input is rejected properly — those requests are SUPPOSED to return 4xx, and the tests pass when they do.\n\nNote: robot_sn and other_partner_sn are pre-filled with real serials. If your database differs, run request 3 first and copy a serial from the response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "robot_sn",
      "value": "GS401-6120-PAQ-B000",
      "type": "string"
    },
    {
      "key": "other_partner_sn",
      "value": "GS101-0100-F4P-H000",
      "type": "string"
    },
    {
      "key": "from_date",
      "value": "2026-06-01",
      "type": "string"
    },
    {
      "key": "to_date",
      "value": "2026-06-30",
      "type": "string"
    },
    {
      "key": "month",
      "value": "2026-06",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "1. Get access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Spec-compliant token response', () => {",
                  "  pm.expect(j.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.token_type).to.eql('Bearer');",
                  "  pm.expect(j.expires_in).to.be.a('number');",
                  "});",
                  "if (j.access_token) {",
                  "  pm.collectionVariables.set('access_token', j.access_token);",
                  "  console.log('Token saved. Valid for', Math.round(j.expires_in / 60), 'minutes.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/oauth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                }
              ]
            },
            "description": "OAuth 2.0 client credentials grant. Form-encoded is what the spec mandates; JSON and HTTP Basic are also accepted. Run this first — everything below depends on the token it saves."
          }
        },
        {
          "name": "2. Verify token (/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Identifies the partner', () => pm.expect(d.partnerName).to.be.a('string').and.not.empty);",
                  "console.log('Authenticated as:', d.partnerName);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "me"
              ]
            }
          }
        },
        {
          "name": "3. List robots",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const robots = pm.response.json().data;",
                  "pm.test('Returns robots', () => pm.expect(robots).to.be.an('array').that.is.not.empty);",
                  "console.log('Robots visible to this partner:', robots.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots"
              ]
            }
          }
        },
        {
          "name": "4. Task reports — date range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().data;",
                  "pm.test('mapName is populated', () => {",
                  "  const blank = p.content.filter(r => !r.mapName).length;",
                  "  pm.expect(blank, blank + ' row(s) with no mapName').to.eql(0);",
                  "});",
                  "console.log('Total tasks in range:', p.totalElements, '| pages:', p.totalPages);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots/{{robot_sn}}/task-reports?startTimeMin={{from_date}}&startTimeMax={{to_date}}&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots",
                "{{robot_sn}}",
                "task-reports"
              ],
              "query": [
                {
                  "key": "startTimeMin",
                  "value": "{{from_date}}"
                },
                {
                  "key": "startTimeMax",
                  "value": "{{to_date}}"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "5. Page size is capped at 100",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('size clamped to 100', () => pm.expect(pm.response.json().data.size).to.eql(100));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots/{{robot_sn}}/task-reports?month={{month}}&size=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots",
                "{{robot_sn}}",
                "task-reports"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "{{month}}"
                },
                {
                  "key": "size",
                  "value": "500"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "invalid_client — wrong secret",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('OAuth error shape', () => pm.expect(pm.response.json().error).to.eql('invalid_client'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/oauth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "pk_deliberately-wrong"
                }
              ]
            },
            "description": "Every failure returns the same invalid_client, so an unknown client id cannot be told apart from a wrong secret."
          }
        },
        {
          "name": "401 — no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots"
              ]
            }
          }
        },
        {
          "name": "404 — another partner's robot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Does not reveal the robot exists', () => {",
                  "  pm.expect(pm.response.json().message).to.include('is available to this partner');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots/{{other_partner_sn}}/task-reports",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots",
                "{{other_partner_sn}}",
                "task-reports"
              ]
            }
          }
        },
        {
          "name": "400 — date with a time",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Explains the format', () => pm.expect(pm.response.json().message).to.include('YYYY-MM-DD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots/{{robot_sn}}/task-reports?startTimeMin=2026-06-01 00:00:00",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots",
                "{{robot_sn}}",
                "task-reports"
              ],
              "query": [
                {
                  "key": "startTimeMin",
                  "value": "2026-06-01 00:00:00"
                }
              ]
            }
          }
        },
        {
          "name": "400 — malformed month",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Explains the format', () => pm.expect(pm.response.json().message).to.include('YYYY-MM'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partner/v1/robots/{{robot_sn}}/task-reports?month=2026-6",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "robots",
                "{{robot_sn}}",
                "task-reports"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-6"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
