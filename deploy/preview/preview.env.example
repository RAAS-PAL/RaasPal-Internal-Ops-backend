# ---------------------------------------------------------------------------
# Copy to preview.env, fill in the four TODOs, then:  chmod 600 preview.env
#
# This is NOT a copy of api.env. It is deliberately minimal: the preview only
# has to serve the PM planner, and every credential left out is one that cannot
# be misused from a non-production box.
# ---------------------------------------------------------------------------

# ─── Database — the sidecar container, NEVER Supabase ─────────────────────
# `db` is the compose service name. Do not put a Supabase URL here; see the
# comment at the top of docker-compose.yml for why it is unrecoverable.
DB_URL=jdbc:postgresql://db:5432/raaspal_pm_preview
DB_USERNAME=preview
# DB_PASSWORD is deliberately NOT set here. docker-compose.yml injects it from
# PREVIEW_DB_PASSWORD in deploy/preview/.env, so the api and the database read
# one value and cannot drift apart.
DB_POOL_MAX=5

# ─── Identity — FRESH secrets, not production's ───────────────────────────
# Copying prod's JWT_SECRET would make a token minted here valid against
# production. Generate with:  openssl rand -base64 48
JWT_SECRET=TODO-openssl-rand-base64-48
PARTNER_JWT_SECRET=TODO-openssl-rand-base64-48
ALLOW_PLACEHOLDER_SECRETS=false

# ─── Public surface ───────────────────────────────────────────────────────
# The Vercel origin serving the branch. Must match exactly or the browser
# blocks every call with a CORS error.
CORS_ALLOWED_ORIGINS=https://pm-preview.raaspal.com
PUBLIC_BASE_URL=https://pm-preview.raaspal.com

FILE_UPLOAD_DIR=/app/uploads/preview

# ─── monday ───────────────────────────────────────────────────────────────
# Same variable the deployed backend already sets: application.properties maps
# it with `app.monday.api.token=${MONDAY_API_TOKEN:}`, and MondayApiClient reads
# that one property for both the case-report sync and this one. So copy the
# value straight out of the production backend's environment — there is no
# separate PM token to create.
#
# Reusing it is safe: the pm package issues no monday mutation, only queries,
# and a full sync costs ~30-40 calls against a ~1,000/day budget.
MONDAY_API_TOKEN=TODO-copy-from-the-deployed-backend-env

# The feature under test. Nightly refresh at 02:30 Asia/Bangkok keeps the
# preview worth showing without anyone touching it.
PM_MONDAY_SYNC_ENABLED=true

# ─── Everything that reaches outside the company — OFF ────────────────────
# All three already default to false in application.properties, so omitting
# them would also be safe. They are written out explicitly because the next
# person to edit this file may start by pasting prod's api.env over it.
#
# REPORT_EMAIL_SCHEDULER_ENABLED is the one that matters: two live deployments
# with it on means customers receive the monthly report twice.
TELEMETRY_SYNC_ENABLED=false
REPORT_EMAIL_SCHEDULER_ENABLED=false
CVTE_KAVA_POLLING_ENABLED=false

# ─── Deliberately absent ──────────────────────────────────────────────────
# No MAIL_* — nothing should be emailed from a preview box.
# No ANTHROPIC_API_KEY — the PM page makes no AI calls, and preview traffic
#   should not bill production's key.
# No GAUSIUM_*, AUTOXING_*, CVTE_* — the PM page touches no robot vendor API.
