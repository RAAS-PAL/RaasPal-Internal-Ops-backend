# ---------------------------------------------------------------------------
# Copy to api.env on the server, fill in the real values, then:  chmod 600 api.env
#
# api.env is NOT in git and must never be. It holds the database password, the
# JWT signing secret, and the Gausium, AutoXing, CVTE, Anthropic and SMTP
# credentials in plaintext. Mode 600 means only the ubuntu user can read it —
# nginx runs as www-data and cannot.
#
# Copy the values out of Render's Environment tab BEFORE switching it off.
# ---------------------------------------------------------------------------

# ─── Database — unchanged, still Supabase ─────────────────────────────────
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=
DB_PASSWORD=
# Keep at 6 while Render and Lightsail are BOTH live: the Supabase session
# pooler caps around 15 connections and each deployment opens its own pool.
# Raise to 10 once Render is switched off.
DB_POOL_MAX=6

# ─── Identity ─────────────────────────────────────────────────────────────
# Copy this from Render rather than generating a new one. The same secret means
# every signed-in user stays signed in through the cutover; a new one logs
# everybody out mid-migration.
JWT_SECRET=
ALLOW_PLACEHOLDER_SECRETS=false

# ─── Public surface ───────────────────────────────────────────────────────
# Both Vercel origins, comma separated. The console calls the API from the
# browser and needs CORS; RIMS calls server-to-server and does not.
CORS_ALLOWED_ORIGINS=https://<console>.vercel.app,https://<rims>.vercel.app
# Used to build the public links in monthly customer report emails.
PUBLIC_BASE_URL=https://<console>.vercel.app
PUBLIC_REPORT_LOCALE=th

# ─── Uploads ──────────────────────────────────────────────────────────────
# Must sit inside the Docker volume mounted at /app/uploads, or survey files
# vanish on the next rebuild.
FILE_UPLOAD_DIR=/app/uploads/customer-surveys

# ─── monday ───────────────────────────────────────────────────────────────
# Required by the PM 52-week planner. application.properties maps this onto
# app.monday.api.token, and MondayApiClient reads that one property for every
# monday caller — there is no separate PM token.
#
# Nothing on main used monday before the planner shipped, so this variable is
# easy to miss on an existing box. Without it the page loads but stays empty:
# V39 creates pm_contract/pm_visit, and POST /api/v1/pm/monday/sync then fails
# with "monday API token is not configured (app.monday.api.token)" because
# nothing ever fills them.
MONDAY_API_TOKEN=

# Nightly PM refresh, 02:30 Asia/Bangkok. Safe to leave on: the pm package
# issues no monday mutation, only queries, and a full sync costs ~30-40 calls
# against a ~1,000/day budget. Unlike the report mailer below it has no effect
# outside the company.
PM_MONDAY_SYNC_ENABLED=true
PM_MONDAY_SYNC_CRON=0 30 2 * * *
PM_MONDAY_SYNC_ZONE=Asia/Bangkok

# ─── Schedulers — LEAVE FALSE UNTIL RENDER IS OFF ─────────────────────────
# This is the only setting in the migration that is visible outside the company.
# If both deployments run with the report mailer enabled, customers receive the
# same monthly report twice, from two servers. Turn these on only after Render
# is suspended.
TELEMETRY_SYNC_ENABLED=false
# Stays false permanently: monthly reports are reviewed and sent by hand, one
# customer at a time. A cron here would mail unreviewed reports.
REPORT_EMAIL_SCHEDULER_ENABLED=false
TELEMETRY_SYNC_CRON=0 0 2 * * *
TELEMETRY_SYNC_ZONE=Asia/Bangkok
TELEMETRY_SYNC_LOOKBACK_DAYS=3
REPORT_EMAIL_SCHEDULER_CRON=0 0 6 1 * *
REPORT_EMAIL_SCHEDULER_ZONE=Asia/Bangkok
# The weekly send IS automatic, by decision: every Monday, the week that just
# ended, to customers with a robot set to Weekly (Tools -> Robots). Separate
# switch, so the monthly rule above is untouched. See DEPLOYMENT.md.
REPORT_WEEKLY_SCHEDULER_ENABLED=true
REPORT_WEEKLY_SCHEDULER_CRON=0 0 8 * * MON
# Pending-case reports: snapshot both monday boards, then freeze that day report.
# One instance only, like telemetry. Two would both write the snapshot, which is
# harmless within a day, but a single writer is the thing that is easy to reason
# about. Every day this stays off is a day nobody can report on afterwards.
CASE_REPORT_SYNC_ENABLED=false
CASE_REPORT_SYNC_CRON=0 15 6 * * *

# ─── AI ───────────────────────────────────────────────────────────────────
# Defaults to "mock" if unset, which fabricates proposals that look real.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_PROPOSAL_MODEL=

# ─── Mail ─────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ─── Robot vendor APIs ────────────────────────────────────────────────────
GAUSIUM_API_BASE_URL=
GAUSIUM_API_CLIENT_ID=
GAUSIUM_API_CLIENT_SECRET=
GAUSIUM_API_OPEN_ACCESS_KEY=

AUTOXING_API_BASE_URL=
AUTOXING_API_APP_ID=
AUTOXING_API_APP_SECRET=
AUTOXING_API_APP_CODE=
AUTOXING_API_APPCODE_SCHEME=

CVTE_KAVA_BASE_URL=
CVTE_KAVA_APP_ID=
CVTE_KAVA_APP_SECRET=
CVTE_KAVA_SIGN_TYPE=
CVTE_KAVA_POLLING_ENABLED=false
CVTE_KAVA_POLLING_INTERVAL_MS=

# ─── monday.com — pending-case reports ────────────────────────────────────
# Required wherever the pending-case reports run: empty means they reach monday
# unauthenticated and fail. Render does not carry this yet, so it is NOT among the
# values copied out of Render. Take it from monday.com instead
# (avatar → Developers → My access tokens).
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2026-07
MONDAY_UPDATES_PER_ITEM=50
# Commented out on purpose. Set to an empty value, Spring takes the empty string
# instead of the default, so every province would count as upcountry and Bangkok
# cases would silently get 5 days instead of 3. Uncomment only to change the list;
# the full default, in Thai and English, is in application.properties.
# CASE_REPORT_METRO_PROVINCES=

# ─── Partner API ──────────────────────────────────────────────────────────
PARTNER_JWT_SECRET=
PARTNER_JWT_EXPIRATION_MS=
PARTNER_RATE_LIMIT_ENABLED=true
PARTNER_RATE_LIMIT_PER_MINUTE=
PARTNER_TOKEN_RATE_LIMIT_PER_MINUTE=
PARTNER_AUDIT_ENABLED=true
PARTNER_AUDIT_RETENTION_DAYS=
PARTNER_AUDIT_CLEANUP_CRON=

# ─── Reports ──────────────────────────────────────────────────────────────
REPORT_CACHE_TTL_MINUTES=
REPORT_CACHE_MAX_SIZE=
