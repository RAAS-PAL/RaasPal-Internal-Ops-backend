# ---------------------------------------------------------------------------
# Copy to api.env on the server, fill in the real values, then:  chmod 600 api.env
#
# api.env is NOT in git and must never be. It holds the database password, the
# JWT signing secret, and the Gausium, AutoXing, CVTE, Anthropic and SMTP
# credentials in plaintext. Mode 600 means only the ubuntu user can read it —
# nginx runs as www-data and cannot.
#
# Copy the values out of Render's Environment tab BEFORE switching it off.
# ---------------------------------------------------------------------------

# ─── Database — unchanged, still Supabase ─────────────────────────────────
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=
DB_PASSWORD=
# Keep at 6 while Render and Lightsail are BOTH live: the Supabase session
# pooler caps around 15 connections and each deployment opens its own pool.
# Raise to 10 once Render is switched off.
DB_POOL_MAX=6

# ─── Identity ─────────────────────────────────────────────────────────────
# Copy this from Render rather than generating a new one. The same secret means
# every signed-in user stays signed in through the cutover; a new one logs
# everybody out mid-migration.
JWT_SECRET=
ALLOW_PLACEHOLDER_SECRETS=false

# ─── Public surface ───────────────────────────────────────────────────────
# Both Vercel origins, comma separated. The console calls the API from the
# browser and needs CORS; RIMS calls server-to-server and does not.
CORS_ALLOWED_ORIGINS=https://<console>.vercel.app,https://<rims>.vercel.app
# Used to build the public links in monthly customer report emails.
PUBLIC_BASE_URL=https://<console>.vercel.app
PUBLIC_REPORT_LOCALE=th

# ─── Uploads ──────────────────────────────────────────────────────────────
# Must sit inside the Docker volume mounted at /app/uploads, or survey files
# vanish on the next rebuild.
FILE_UPLOAD_DIR=/app/uploads/customer-surveys

# ─── Schedulers — LEAVE FALSE UNTIL RENDER IS OFF ─────────────────────────
# This is the only setting in the migration that is visible outside the company.
# If both deployments run with the report mailer enabled, customers receive the
# same monthly report twice, from two servers. Turn these on only after Render
# is suspended.
TELEMETRY_SYNC_ENABLED=false
REPORT_EMAIL_SCHEDULER_ENABLED=false
TELEMETRY_SYNC_CRON=0 0 2 * * *
TELEMETRY_SYNC_ZONE=Asia/Bangkok
TELEMETRY_SYNC_LOOKBACK_DAYS=3
REPORT_EMAIL_SCHEDULER_CRON=0 0 6 1 * *
REPORT_EMAIL_SCHEDULER_ZONE=Asia/Bangkok

# ─── AI ───────────────────────────────────────────────────────────────────
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_PROPOSAL_MODEL=

# ─── Mail ─────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ─── Robot vendor APIs ────────────────────────────────────────────────────
GAUSIUM_API_BASE_URL=
GAUSIUM_API_CLIENT_ID=
GAUSIUM_API_CLIENT_SECRET=
GAUSIUM_API_OPEN_ACCESS_KEY=

AUTOXING_API_BASE_URL=
AUTOXING_API_APP_ID=
AUTOXING_API_APP_SECRET=
AUTOXING_API_APP_CODE=
AUTOXING_API_APPCODE_SCHEME=

CVTE_KAVA_BASE_URL=
CVTE_KAVA_APP_ID=
CVTE_KAVA_APP_SECRET=
CVTE_KAVA_SIGN_TYPE=
CVTE_KAVA_POLLING_ENABLED=false
CVTE_KAVA_POLLING_INTERVAL_MS=

# ─── Partner API ──────────────────────────────────────────────────────────
PARTNER_JWT_SECRET=
PARTNER_JWT_EXPIRATION_MS=
PARTNER_RATE_LIMIT_ENABLED=true
PARTNER_RATE_LIMIT_PER_MINUTE=
PARTNER_TOKEN_RATE_LIMIT_PER_MINUTE=
PARTNER_AUDIT_ENABLED=true
PARTNER_AUDIT_RETENTION_DAYS=
PARTNER_AUDIT_CLEANUP_CRON=

# ─── Reports ──────────────────────────────────────────────────────────────
REPORT_CACHE_TTL_MINUTES=
REPORT_CACHE_MAX_SIZE=
